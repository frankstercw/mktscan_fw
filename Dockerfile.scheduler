# MktScan scheduler (background worker).
#
# This service owns the database schema: it runs `alembic upgrade head` at boot
# and seeds IV history on first run. The dashboard deliberately does not, so the
# two containers cannot contend for the same DDL lock on startup.
FROM python:3.11-slim

ARG REQUIREMENTS=requirements-railway.txt

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

COPY requirements*.txt ./
RUN pip install --no-cache-dir --prefer-binary -r ${REQUIREMENTS}

COPY . .

RUN mkdir -p data logs && chmod +x scripts/*.sh

# scheduler.py serves a plain-text health endpoint on $PORT so Railway can see
# the worker as alive.
HEALTHCHECK --interval=60s --timeout=10s --start-period=300s --retries=3 \
    CMD curl -fsS "http://localhost:${PORT:-8080}/" || exit 1

CMD ["./scripts/start-scheduler.sh"]
